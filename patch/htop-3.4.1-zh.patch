+/* Translate a string ignoring its trailing padding spaces */
+const char* CRT_transTrim(const char* s) {
+   static char buffers[8][128];
+   static unsigned int next = 0;
+
+   if (!s)
+      return s;
+
+   char* out = buffers[next++ & 7u];
+   xSnprintf(out, sizeof(buffers[0]), "%s", s);
+   size_t len = strlen(out);
+   while (len > 0 && out[len - 1] == ' ')
+      out[--len] = '\0';
+
+   return CRT_trans(out);
 }
