+static bool CRT_i18nInitialized = false;
+static bool CRT_zhActive = false;
+
+static bool CRT_envWantsChinese(void) {
+   const char* env = getenv("HTOP_LANG");
+   if (env && *env) {
+      if (strstr(env, "zh") || strstr(env, "ZH") || strstr(env, "cn") || strstr(env, "CN"))
+         return true;
+      if (String_eq(env, "en") || String_eq(env, "C") || String_eq(env, "c"))
+         return false;
+   }
+
+   static const char* const vars[] = { "LC_ALL", "LC_CTYPE", "LANG", NULL };
+   for (int i = 0; vars[i]; i++) {
+      env = getenv(vars[i]);
+      if (!env || !*env)
+         continue;
+      if ((env[0] == 'z' && env[1] == 'h') || (env[0] == 'Z' && env[1] == 'H'))
+         return true;
+      break;
+   }
+
+   return false;
+}
+
+void CRT_i18nInit(void) {
+   if (CRT_i18nInitialized)
+      return;
+   CRT_i18nInitialized = true;
+
+   CRT_zhActive = CRT_envWantsChinese();
+   if (!CRT_zhActive)
+      return;
+
+   /* Double width characters require an UTF-8 locale to be rendered by ncurses */
+   if (!String_eq(nl_langinfo(CODESET), "UTF-8")) {
+      static const char* const candidates[] = { "C.UTF-8", "zh_CN.UTF-8", "en_US.UTF-8", NULL };
+      for (int i = 0; candidates[i]; i++) {
+         if (setlocale(LC_CTYPE, candidates[i]) && String_eq(nl_langinfo(CODESET), "UTF-8"))
+            break;
+      }
+      if (!String_eq(nl_langinfo(CODESET), "UTF-8"))
+         CRT_zhActive = false;
+   }
+}
+
+bool CRT_isChinese(void) {
+   if (!CRT_i18nInitialized)
+      CRT_i18nInit();
+   return CRT_zhActive;
+}
+
+int CRT_strWidth(const char* s) {
+   if (!s)
+      return 0;
+
+   if (!String_eq(nl_langinfo(CODESET), "UTF-8"))
+      return (int)strlen(s);
+
+   int width = 0;
+   mbstate_t state;
+   memset(&state, 0, sizeof(state));
+
+   while (*s) {
+      wchar_t wc;
+      size_t n = mbrtowc(&wc, s, MB_CUR_MAX, &state);
+      if (n == (size_t)-1 || n == (size_t)-2) {
+         width++;
+         s++;
+         memset(&state, 0, sizeof(state));
+         continue;
+      }
+      if (n == 0)
+         break;
+      int cw = wcwidth(wc);
+      width += cw > 0 ? cw : 1;
+      s += n;
+   }
+
+   return width;
+}
+
+const char* CRT_trans(const char* en) {
+   if (!en || !CRT_isChinese())
+      return en;
+
+   for (size_t i = 0; i < ARRAYSIZE(CRT_zhTable); i++) {
+      if (String_eq(CRT_zhTable[i].en, en))
+         return CRT_zhTable[i].zh;
+   }
+
+   return en;
+}
+
+/* Translate a fixed width function bar label, keeping the original width */
+const char* CRT_transPad(const char* label, int width) {
+   static char buffers[8][128];
+   static unsigned int next = 0;
+
+   if (!label || width <= 0 || !CRT_isChinese())
+      return label;
+
+   char key[64];
+   size_t len = strlen(label);
+   while (len > 0 && label[len - 1] == ' ')
+      len--;
+   if (len >= sizeof(key))
+      len = sizeof(key) - 1;
+   memcpy(key, label, len);
+   key[len] = '\0';
+
+   const char* zh = CRT_trans(key);
+   if (zh == key || String_eq(zh, key))
+      return label;
+
+   char* out = buffers[next++ & 7u];
+   int zhWidth = CRT_strWidth(zh);
+   if (zhWidth > width) {
+      const char* clipped = CRT_transClip(zh, width);
+      xSnprintf(out, sizeof(buffers[0]), "%s", clipped);
+      return out;
+   }
+
+   xSnprintf(out, sizeof(buffers[0]), "%s", zh);
+   size_t pos = strlen(out);
+   for (int i = zhWidth; i < width && pos + 1 < sizeof(buffers[0]); i++)
+      out[pos++] = ' ';
+   out[pos] = '\0';
+
+   return out;
+}
+
+const char* CRT_transClip(const char* s, int maxWidth) {
+   static char buffers[4][256];
+   static unsigned int next = 0;
+
+   char* out = buffers[next++ & 3u];
+   out[0] = '\0';
+
+   if (!s || maxWidth <= 0)
+      return out;
+
+   mbstate_t state;
+   memset(&state, 0, sizeof(state));
+   int width = 0;
+   size_t written = 0;
+
+   const char* p = s;
+   while (*p && written + 4 < sizeof(buffers[0])) {
+      wchar_t wc;
+      size_t n = mbrtowc(&wc, p, MB_CUR_MAX, &state);
+      if (n == (size_t)-1 || n == (size_t)-2) {
+         n = 1;
